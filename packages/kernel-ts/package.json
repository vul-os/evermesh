{
  "name": "@evermesh/kernel",
  "version": "0.0.1",
  "description": "Typed TypeScript API over the Evermesh WASM kernel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/evermesh-wasm --target web --out-dir ../../packages/kernel-ts/wasm --out-name evermesh_wasm --no-pack --release",
    "build": "tsc -p tsconfig.build.json && node scripts/emit-cjs.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
